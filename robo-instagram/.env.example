# Copie para ".env" e preencha (veja o passo a passo no README).
# Id da conta profissional do Instagram (número, não o @)
IG_USER_ID=
# Token de acesso com instagram_basic, instagram_content_publish, pages_show_list e pages_read_engagement
IG_TOKEN=
# App da Meta (para o robô renovar o token sozinho antes de vencer)
FB_APP_ID=
FB_APP_SECRET=
