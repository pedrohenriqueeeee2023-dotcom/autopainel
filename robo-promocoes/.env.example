# Copie este arquivo para ".env" e preencha.
# Chaves do painel affiliate.shopee.com.br > Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Seu número pessoal (com 55 + DDD), só ele pode dar comandos ao robô
DONO=5511999999999

# Senha do painel. Só precisa se o robô rodar numa VPS (painel acessível pela internet).
PAINEL_SENHA=

# App de desenvolvedor do Mercado Livre (developers.mercadolivre.com.br) - use configurar-ml.sh
ML_CLIENT_ID=
ML_CLIENT_SECRET=
